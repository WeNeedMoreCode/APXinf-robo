From 6579dbf93715a48c44e1f5be08c689cc23f18a51 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E7=B4=A0=E7=8E=84?= <suxuan@gitcode.com>
Date: Thu, 15 Oct 2026 20:34:50 +0800
Subject: [PATCH] T4R: e2e_run downloads kv at cur_output_dims in gear mode
 (mirror download_kv)

Gear OM materializes output buffers at the max bucket (712 rows for L=200
max); running a mid bucket (L=154, 666 rows) leaves the tail unwritten.
The probe's e2e path downloaded full buffers, breaking golden length
asserts and dumping stale tails. Production download_kv already uses
cur_output_dims; now the probe path and its bench block do too.

Co-Authored-By: Claude Code <no-reply@anthropic.com>
---
 crates/apxinf-model/src/pi05/ascend_ge.rs | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/crates/apxinf-model/src/pi05/ascend_ge.rs b/crates/apxinf-model/src/pi05/ascend_ge.rs
index 3c39f83..e27b39e 100644
--- a/crates/apxinf-model/src/pi05/ascend_ge.rs
+++ b/crates/apxinf-model/src/pi05/ascend_ge.rs
@@ -2363,8 +2363,17 @@ pub fn e2e_run(ctx: &AscendContext, stream: &AscendStream, s: &mut Seg, seg: &st
     let refs: Vec<&DeviceBuffer> = outs.iter().collect();
     s.run_seg(gi, &refs, stream).expect("ge run");
     drop(stream.synchronize());
+    // kv 下载行数：gear 模式按当前档实际输出（cur_output_dims——同生产
+    // download_kv；buffer 按 max 档物化，尾部是未写残留）；静态 = 满 buffer
+    let out_n = |i: usize| -> usize {
+        if s.gear_payloads.is_empty() {
+            s.g.output_size(i).unwrap() / 2
+        } else {
+            s.g.cur_output_dims(i).unwrap().iter().product::<i64>() as usize
+        }
+    };
     let dl: Vec<Vec<f16>> = (0..n_out)
-        .map(|i| download_f16(ctx, &outs[i], s.g.output_size(i).unwrap() / 2))
+        .map(|i| download_f16(ctx, &outs[i], out_n(i)))
         .collect();
     // GEB_E2E_BENCH=N：稳态 rerun bench（输入 binds 不变重跑；含全输出 d2h
     // ——prefix 的 36 路 kv 下载 = today 生产 host 中转 glue，如实计入）
@@ -2376,7 +2385,7 @@ pub fn e2e_run(ctx: &AscendContext, stream: &AscendStream, s: &mut Seg, seg: &st
             s.run_seg(gi, &refs, stream).expect("ge run");
             drop(stream.synchronize());
             let _: Vec<_> = (0..n_out)
-                .map(|i| download_f16(ctx, &outs[i], s.g.output_size(i).unwrap() / 2))
+                .map(|i| download_f16(ctx, &outs[i], out_n(i)))
                 .collect();
             ts.push(t.elapsed().as_secs_f64() * 1e3);
         }
