+        }
+
+        /// Last frame's segment timings (vision_ms, prefix_ms, flow_ms).
+        #[getter]
+        fn last_ms(&self) -> (f32, f32, f32) {
+            self.last_ms.get()
+        }
+
+        fn __repr__(&self) -> String {
+            format!(
