+
+    fn gelu(&mut self, name: &str, x: &str, dims: &[i64], tanh: bool) -> String {
+        self.g.add_op(name, "GeluV2").unwrap();
+        self.g.set_input_desc(name, "x", dims, Dtype::Fp16).unwrap();
+        self.g.set_output_desc(name, "y", dims, Dtype::Fp16).unwrap();
