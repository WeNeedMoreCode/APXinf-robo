+extern "C" int64_t geb_input_size(int64_t h, int32_t idx) {
+    const GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded || (idx < 0) || (static_cast<size_t>(idx) >= m->in_sizes.size())) {
+        return -1;
