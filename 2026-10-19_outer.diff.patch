+#!/bin/bash
+# ab_golden_dyn_static_1015.sh — I10 后续·回退桶根因：动态 OM vs 静态 OM 各自 vs
+# torch golden（L=200 真帧 frame0_v3b，含 18 层 kvk 逐层对拍 + 段边界中间量）。
+# 同芯背靠背直调（chip5 已清空），环境与生产 serve 完全同款。
+source /data/apxinf/rust_env.sh
