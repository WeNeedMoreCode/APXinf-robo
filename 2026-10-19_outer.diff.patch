+// link with an explicit SOURCE output port. SetInput(dst, src_op) resolves
+// the src's default output -- for multi-output ops (AddRmsNorm's
+// y/rstd/x_out, ARPE's q/k) that resolution silently fails and the edge
+// never attaches (dump shows in0<-<none>, compile then dies at the
+// unlinked consumer). Always use this form when the src has >1 output.
+extern "C" int geb_link_out(const char *dst_op, const char *dst_port, const char *src_op,
+                            const char *src_out_port) {
+    GebModel *m = Cur();
+    if (m == nullptr) {
+        return -1;
+    }
+    ge::Operator *dst = FindOp(*m, dst_op, "link_out");
+    ge::Operator *src = FindOp(*m, src_op, "link_out");
+    if ((dst == nullptr) || (src == nullptr)) {
+        return -2;
+    }
+    (void)dst->SetInput(std::string(dst_port), *src, std::string(src_out_port));
+    return 0;
+}
+
+extern "C" int geb_graph_inputs(const char *const *names, int32_t n) {
+    GebModel *m = Cur();
+    if (m == nullptr) {
+        return -1;
+    }
+    m->in_ops.clear();
+    for (int32_t i = 0; i < n; i++) {
+        ge::Operator *op = FindOp(*m, names[i], "graph_inputs");
+        if (op == nullptr) {
+            m->in_ops.clear();
+            return -2;
+        }
+        m->in_ops.push_back(*op);
+    }
+    return 0;
+}
+
+extern "C" int geb_graph_outputs(const char *const *names, int32_t n) {
+    GebModel *m = Cur();
+    if (m == nullptr) {
+        return -1;
+    }
+    m->out_ops.clear();
+    m->out_pairs.clear();
+    for (int32_t i = 0; i < n; i++) {
+        ge::Operator *op = FindOp(*m, names[i], "graph_outputs");
+        if (op == nullptr) {
+            m->out_ops.clear();
+            return -2;
+        }
+        m->out_ops.push_back(*op);
+    }
+    return 0;
+}
+
+// graph outputs with explicit output-port index: entry i binds output port
+// out_idxs[i] of operator names[i] (RmsNorm rstd=1, ARPE key=1, ...)
+extern "C" int geb_graph_outputs_idx(const char *const *names, const int32_t *out_idxs, int32_t n) {
+    GebModel *m = Cur();
+    if (m == nullptr) {
+        return -1;
+    }
+    m->out_ops.clear();
+    m->out_pairs.clear();
+    for (int32_t i = 0; i < n; i++) {
+        ge::Operator *op = FindOp(*m, names[i], "graph_outputs_idx");
+        if (op == nullptr) {
+            m->out_pairs.clear();
+            return -2;
+        }
+        m->out_pairs.emplace_back(*op, std::vector<size_t>{static_cast<size_t>(out_idxs[i])});
+    }
+    return 0;
+}
+
+// ---- loaded-model IO introspection ----
+
+extern "C" int32_t geb_num_inputs(int64_t h) {
+    const GebModel *m = ByHandle(h);
+    return (m != nullptr) && m->loaded ? static_cast<int32_t>(m->in_sizes.size()) : -1;
+}
+
+extern "C" int32_t geb_num_outputs(int64_t h) {
+    const GebModel *m = ByHandle(h);
+    return (m != nullptr) && m->loaded ? static_cast<int32_t>(m->out_sizes.size()) : -1;
+}
+
+extern "C" int64_t geb_input_size(int64_t h, int32_t idx) {
+    const GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded || (idx < 0) || (static_cast<size_t>(idx) >= m->in_sizes.size())) {
+        return -1;
+    }
+    return static_cast<int64_t>(m->in_sizes[static_cast<size_t>(idx)]);
+}
+
+extern "C" int64_t geb_output_size(int64_t h, int32_t idx) {
+    const GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded || (idx < 0) ||
+        (static_cast<size_t>(idx) >= m->out_sizes.size())) {
+        return -1;
+    }
+    return static_cast<int64_t>(m->out_sizes[static_cast<size_t>(idx)]);
+}
+
+// returns n_dims (or negative on error); fills out_dims[0..min(cap,n_dims))
+extern "C" int32_t geb_input_dims(int64_t h, int32_t idx, int64_t *out_dims, int32_t cap) {
+    const GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded) {
+        return -1;
+    }
+    aclmdlDesc *d = aclmdlCreateDesc();
+    if ((d == nullptr) || (aclmdlGetDesc(d, m->model_id) != ACL_SUCCESS)) {
+        if (d != nullptr) {
+            aclmdlDestroyDesc(d);
+        }
+        return -2;
+    }
+    aclmdlIODims dims{};
+    const aclError e = aclmdlGetInputDims(d, static_cast<size_t>(idx), &dims);
+    aclmdlDestroyDesc(d);
+    if (e != ACL_SUCCESS) {
+        return -3;
+    }
+    for (size_t i = 0; (i < dims.dimCount) && (i < static_cast<size_t>(cap)); i++) {
+        out_dims[i] = static_cast<int64_t>(dims.dims[i]);
+    }
+    return static_cast<int32_t>(dims.dimCount);
+}
+
+extern "C" int32_t geb_output_dims(int64_t h, int32_t idx, int64_t *out_dims, int32_t cap) {
+    const GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded) {
+        return -1;
+    }
+    aclmdlDesc *d = aclmdlCreateDesc();
+    if ((d == nullptr) || (aclmdlGetDesc(d, m->model_id) != ACL_SUCCESS)) {
+        if (d != nullptr) {
+            aclmdlDestroyDesc(d);
+        }
+        return -2;
+    }
+    aclmdlIODims dims{};
+    const aclError e = aclmdlGetOutputDims(d, static_cast<size_t>(idx), &dims);
+    aclmdlDestroyDesc(d);
+    if (e != ACL_SUCCESS) {
+        return -3;
+    }
+    for (size_t i = 0; (i < dims.dimCount) && (i < static_cast<size_t>(cap)); i++) {
+        out_dims[i] = static_cast<int64_t>(dims.dims[i]);
+    }
+    return static_cast<int32_t>(dims.dimCount);
+}
+
+// ---- run ----
+
+// stream != nullptr -> aclmdlExecuteAsync on that stream (caller syncs);
+// stream == nullptr -> synchronous aclmdlExecute (debug/discrimination variant)
+extern "C" int geb_run(int64_t h, void *const *inputs, int32_t n_in, void *const *outputs,
+                       int32_t n_out, void *stream) {
+    GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded) {
+        return -1;
+    }
+    if ((n_in < 0) || (static_cast<size_t>(n_in) != m->in_sizes.size())) {
+        std::cerr << "[geb] run: n_in " << n_in << " != model " << m->in_sizes.size() << std::endl;
+        return -2;
+    }
+    if ((n_out < 0) || (static_cast<size_t>(n_out) != m->out_sizes.size())) {
+        std::cerr << "[geb] run: n_out " << n_out << " != model " << m->out_sizes.size() << std::endl;
+        return -3;
+    }
+    aclmdlDataset *in_ds = aclmdlCreateDataset();
+    for (int32_t i = 0; i < n_in; i++) {
+        (void)aclmdlAddDatasetBuffer(in_ds, aclCreateDataBuffer(inputs[i], m->in_sizes[static_cast<size_t>(i)]));
+    }
+    aclmdlDataset *out_ds = aclmdlCreateDataset();
+    for (int32_t i = 0; i < n_out; i++) {
+        (void)aclmdlAddDatasetBuffer(out_ds,
+                                     aclCreateDataBuffer(outputs[i], m->out_sizes[static_cast<size_t>(i)]));
+    }
+    const aclError e = (stream != nullptr)
+        ? aclmdlExecuteAsync(m->model_id, in_ds, out_ds, static_cast<aclrtStream>(stream))
+        : aclmdlExecute(m->model_id, in_ds, out_ds);
+    for (int32_t i = 0; i < n_in; i++) {
+        aclDestroyDataBuffer(aclmdlGetDatasetBuffer(in_ds, static_cast<size_t>(i)));
+    }
+    for (int32_t i = 0; i < n_out; i++) {
+        aclDestroyDataBuffer(aclmdlGetDatasetBuffer(out_ds, static_cast<size_t>(i)));
+    }
+    aclmdlDestroyDataset(in_ds);
+    aclmdlDestroyDataset(out_ds);
+    if (e != ACL_SUCCESS) {
+        std::cerr << "[geb] execute err=" << static_cast<int>(e) << std::endl;
+        return -4;
+    }
+    return 0;
+}
+
+// ---- dynamic gear (ge.dynamicDims OMs) ----
+
+// Gear census of a loaded model. Returns 0 for static OMs, N>0 for an
+// N-gear dynamic OM, negative on error.
+extern "C" int geb_gear_count(int64_t h) {
+    const GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded) {
+        return -1;
+    }
+    return static_cast<int>(m->gear_count);
+}
+
+// Full dims of all dynamic inputs for one gear (concatenated, input order --
+// the aclmdlSetInputDynamicDims payload). Returns dimCount, negative on error.
+extern "C" int geb_gear_dims(int64_t h, int32_t gear, int64_t *out_dims, int32_t cap) {
+    const GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded) {
+        return -1;
+    }
+    if ((gear < 0) || (static_cast<size_t>(gear) >= m->gear_count)) {
+        return -2;
+    }
+    const auto &gd = m->gear_dims[static_cast<size_t>(gear)];
+    const int32_t n = static_cast<int32_t>(gd.size());
+    if ((out_dims == nullptr) || (cap < n)) {
+        return n;  // capacity probe: caller re-calls with a big enough buffer
+    }
+    for (int32_t i = 0; i < n; i++) {
+        out_dims[i] = gd[static_cast<size_t>(i)];
+    }
+    return n;
+}
+
+// Gear-aware run. dyn_dims/n_dyn = full dims of all dynamic inputs in input
+// order (spike S2 recipe: ONE SetInputDynamicDims call on input 0 carrying
+// every dynamic input's dims). For dynamic OMs n_in counts the REAL inputs
+// only -- the trailing shape-data input is buffered and filled here. Static
+// OMs (gear_count==0): dyn_dims ignored, behaves exactly like geb_run.
+extern "C" int geb_run_gear(int64_t h, void *const *inputs, int32_t n_in, void *const *outputs,
+                            int32_t n_out, void *stream, const int64_t *dyn_dims, int32_t n_dyn) {
+    GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded) {
+        return -1;
+    }
+    const size_t real_in = m->gear_count > 0 ? m->in_sizes.size() - 1 : m->in_sizes.size();
+    if ((n_in < 0) || (static_cast<size_t>(n_in) != real_in)) {
+        std::cerr << "[geb] run_gear: n_in " << n_in << " != real inputs " << real_in << std::endl;
+        return -2;
+    }
+    if ((n_out < 0) || (static_cast<size_t>(n_out) != m->out_sizes.size())) {
+        std::cerr << "[geb] run_gear: n_out " << n_out << " != model " << m->out_sizes.size() << std::endl;
+        return -3;
+    }
+    if (m->gear_count > 0) {
+        if ((dyn_dims == nullptr) || (n_dyn <= 0)) {
+            std::cerr << "[geb] run_gear: dynamic OM needs dyn_dims" << std::endl;
+            return -5;
+        }
+    }
+    aclmdlDataset *in_ds = aclmdlCreateDataset();
+    for (int32_t i = 0; i < n_in; i++) {
+        (void)aclmdlAddDatasetBuffer(in_ds,
+                                     aclCreateDataBuffer(inputs[i], m->in_sizes[static_cast<size_t>(i)]));
+    }
+    if (m->gear_count > 0) {
+        // trailing shape-data input: cached device slot, filled by SetDims
+        const size_t gsz = m->in_sizes.back();
+        if (m->gear_buf == nullptr) {
+            if (aclrtMalloc(&m->gear_buf, gsz, ACL_MEM_MALLOC_HUGE_ONLY) != ACL_SUCCESS) {
+                m->gear_buf = nullptr;
+                std::cerr << "[geb] run_gear: gear buf malloc failed" << std::endl;
+                return -6;
+            }
+            m->gear_buf_sz = gsz;
+        }
+        (void)aclmdlAddDatasetBuffer(in_ds, aclCreateDataBuffer(m->gear_buf, gsz));
+    }
+    aclmdlDataset *out_ds = aclmdlCreateDataset();
+    for (int32_t i = 0; i < n_out; i++) {
+        (void)aclmdlAddDatasetBuffer(out_ds,
+                                     aclCreateDataBuffer(outputs[i], m->out_sizes[static_cast<size_t>(i)]));
+    }
+    aclError e = ACL_SUCCESS;
+    if (m->gear_count > 0) {
+        aclmdlIODims want{};
+        for (int32_t i = 0; (i < n_dyn) && (i < static_cast<int32_t>(ACL_MAX_DIM_CNT)); i++) {
+            want.dims[static_cast<size_t>(i)] = static_cast<size_t>(dyn_dims[i]);
+        }
+        want.dimCount = static_cast<size_t>(n_dyn < static_cast<int32_t>(ACL_MAX_DIM_CNT)
+                                                ? n_dyn
+                                                : static_cast<int32_t>(ACL_MAX_DIM_CNT));
+        e = aclmdlSetInputDynamicDims(m->model_id, in_ds, 0, &want);
+        if (e != ACL_SUCCESS) {
+            std::cerr << "[geb] run_gear: SetInputDynamicDims err=" << static_cast<int>(e) << std::endl;
+        }
+    }
+    if (e == ACL_SUCCESS) {
+        e = (stream != nullptr) ? aclmdlExecuteAsync(m->model_id, in_ds, out_ds,
+                                                     static_cast<aclrtStream>(stream))
+                                : aclmdlExecute(m->model_id, in_ds, out_ds);
+        if (e != ACL_SUCCESS) {
+            std::cerr << "[geb] execute err=" << static_cast<int>(e) << std::endl;
+        }
+    }
+    for (int32_t i = 0; i < n_in; i++) {
+        aclDestroyDataBuffer(aclmdlGetDatasetBuffer(in_ds, static_cast<size_t>(i)));
+    }
+    if (m->gear_count > 0) {
+        aclDestroyDataBuffer(aclmdlGetDatasetBuffer(in_ds, static_cast<size_t>(n_in)));
+    }
+    for (int32_t i = 0; i < n_out; i++) {
+        aclDestroyDataBuffer(aclmdlGetDatasetBuffer(out_ds, static_cast<size_t>(i)));
+    }
+    aclmdlDestroyDataset(in_ds);
+    aclmdlDestroyDataset(out_ds);
+    return (e == ACL_SUCCESS) ? 0 : -4;
+}
+
+// Output dims of the LAST executed gear (aclmdlGetCurOutputDims). Rank>=3
+// outputs with a dynamic non-last dim are laid out at MAX-gear stride --
+// consumers must honour that (spike v2 empirical).
+extern "C" int geb_cur_output_dims(int64_t h, int32_t idx, int64_t *out_dims, int32_t cap) {
+    GebModel *m = ByHandle(h);
+    if ((m == nullptr) || !m->loaded) {
+        return -1;
+    }
+    aclmdlDesc *d = aclmdlCreateDesc();
+    if (d == nullptr) {
+        return -2;
+    }
+    if (aclmdlGetDesc(d, m->model_id) != ACL_SUCCESS) {
+        aclmdlDestroyDesc(d);
+        return -3;
+    }
+    aclmdlIODims dims{};
+    const aclError e = aclmdlGetCurOutputDims(d, static_cast<size_t>(idx), &dims);
+    aclmdlDestroyDesc(d);
+    if (e != ACL_SUCCESS) {
+        return -4;
+    }
+    const int32_t n = static_cast<int32_t>(dims.dimCount);
+    if ((out_dims == nullptr) || (cap < n)) {
+        return n;
+    }
+    for (int32_t i = 0; i < n; i++) {
+        out_dims[i] = static_cast<int64_t>(dims.dims[static_cast<size_t>(i)]);
+    }
+    return n;
+}
diff --git a/syx_docs/dev_logs/probe_dyn/gear_inq_probe.c b/syx_docs/dev_logs/probe_dyn/gear_inq_probe.c
new file mode 100644
index 0000000..a124ea1
--- /dev/null
+++ b/syx_docs/dev_logs/probe_dyn/gear_inq_probe.c
@@ -0,0 +1,80 @@
+#include <acl/acl_base.h>
+#include <acl/acl_mdl.h>
+#include <acl/acl_rt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+int main(int argc, char **argv) {
+    const char *path = argc > 1 ? argv[1] : "/data/apxinf/om_cache/tl_dyn/prefix_real.om";
+    setbuf(stdout, NULL);
+    if (aclInit(NULL) != ACL_SUCCESS) {}
+    aclrtSetDevice(0);
+    aclrtContext c; aclrtCreateContext(&c, 0);
+    uint32_t m = 0;
+    if (aclmdlLoadFromFile(path, &m) != ACL_SUCCESS) { printf("load fail\n"); return 1; }
+    aclmdlDesc *d = aclmdlCreateDesc();
+    aclmdlGetDesc(d, m);
+    size_t nin = aclmdlGetNumInputs(d);
+    printf("n_in=%zu\n", nin);
+    for (size_t i = 0; i < nin && i < 20; i++) {
+        aclmdlIODims dm; memset(&dm, 0, sizeof(dm));
+        aclmdlGetInputDims(d, i, &dm);
+        printf("in[%zu] dimCount=%zu dims=", i, dm.dimCount);
+        for (size_t k = 0; k < dm.dimCount; k++) printf("%lld,", (long long)dm.dims[k]);
+        printf("\n");
+    }
+    for (size_t i = nin - 3; i < nin; i++) {
+        aclmdlIODims dm; memset(&dm, 0, sizeof(dm));
+        aclmdlGetInputDims(d, i, &dm);
+        printf("in[%zu] dimCount=%zu dims[0]=%lld\n", i, dm.dimCount, (long long)dm.dims[0]);
+    }
+    // 假设试验：A) SetDims index=gear 输入位（262）+ 14 动态值；
+    // B) 直写 gear buffer 14 值 + 裸 execute → GetCurOutputDims 判分支
+    if (argc > 2) {
+        int64_t vals[128];
+        size_t nv = 0;
+        FILE *df = fopen(argv[2], "r");
+        while (nv < 128 && fscanf(df, "%lld,", &vals[nv]) == 1) nv++;
+        fclose(df);
+        void **db = calloc(nin, sizeof(void *));
+        aclmdlDataset *ds = aclmdlCreateDataset();
+        size_t *szs = calloc(nin, sizeof(size_t));
+        for (size_t i = 0; i < nin; i++) {
+            szs[i] = aclmdlGetInputSizeByIndex(d, i);
+            aclrtMalloc(&db[i], szs[i], ACL_MEM_MALLOC_HUGE_FIRST);
+            aclmdlAddDatasetBuffer(ds, aclCreateDataBuffer(db[i], szs[i]));
+        }
+        size_t nout = aclmdlGetNumOutputs(d);
+        void **ob = calloc(nout, sizeof(void *));
+        aclmdlDataset *ods = aclmdlCreateDataset();
+        for (size_t i = 0; i < nout; i++) {
+            size_t sz = aclmdlGetOutputSizeByIndex(d, i);
+            aclrtMalloc(&ob[i], sz, ACL_MEM_MALLOC_HUGE_FIRST);
+            aclmdlAddDatasetBuffer(ods, aclCreateDataBuffer(ob[i], sz));
+        }
+        aclmdlIODims want;
+        memset(&want, 0, sizeof(want));
+        want.dimCount = nv;
+        for (size_t i = 0; i < nv; i++) want.dims[i] = (size_t)vals[i];
+        // tryB1：直写 gear buffer int32 动态维值（spike gear 输入 12B=3×int32
+        // ⇒ 元素类型 int32；值 = 动态维值表）+ 裸 execute
+        printf("[tryB] gear input size=%zu\n", szs[nin - 1]);
+        int *gb = (int *)db[nin - 1];
+        for (size_t i = 0; i < nv && (i + 1) * 4 <= szs[nin - 1]; i++) gb[i] = (int)vals[i];
+        aclError re2 = aclmdlExecute(m, ds, ods);
+        aclmdlIODims cur2; memset(&cur2, 0, sizeof(cur2));
+        aclmdlGetCurOutputDims(d, 0, &cur2);
+        printf("[tryB1] direct-buffer(int32 dims) execute rc=%d curOut0=%lld\n", (int)re2,
+               cur2.dimCount > 0 ? (long long)cur2.dims[0] : -1LL);
+        if (re2 != ACL_SUCCESS) {
+            // tryB2：值不灵 → 试档下标（0 起）
+            for (size_t i = 0; i * 4 < szs[nin - 1]; i++) gb[i] = 0;
+            aclError re3 = aclmdlExecute(m, ds, ods);
+            aclmdlIODims cur3; memset(&cur3, 0, sizeof(cur3));
+            aclmdlGetCurOutputDims(d, 0, &cur3);
+            printf("[tryB2] direct-buffer(int32 idx=0) execute rc=%d curOut0=%lld\n", (int)re3,
+                   cur3.dimCount > 0 ? (long long)cur3.dims[0] : -1LL);
+        }
+    }
+    return 0;
+}
diff --git a/syx_docs/dev_logs/probe_dyn/gear_load_probe.c b/syx_docs/dev_logs/probe_dyn/gear_load_probe.c
new file mode 100644
index 0000000..0a4fe42
--- /dev/null
+++ b/syx_docs/dev_logs/probe_dyn/gear_load_probe.c
@@ -0,0 +1,109 @@
+// gear_load_probe.c — 动态档 OM 装载路径对拍：aclmdlLoadFromFile vs
+// aclmdlLoadFromMem（serve 的 geb_model_load 走 FromMem，装载后
+// GetInputDynamicGearCount=0——档位信息疑似只在文件装载路径存活）
+#include <acl/acl_base.h>
+#include <acl/acl_mdl.h>
+#include <acl/acl_rt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(int argc, char **argv) {
+    const char *path = argc > 1 ? argv[1] : "/data/apxinf/om_cache/tl_dyn/prefix_real.om";
+    if (aclInit(NULL) != ACL_SUCCESS) printf("[probe] aclInit nonzero (continue)\n");
+    if (aclrtSetDevice(0) != ACL_SUCCESS) { printf("setdev fail\n"); return 1; }
+    aclrtContext ctx;
+    aclrtCreateContext(&ctx, 0);
+
+    // SetDims 全维匹配试验（S2 同式：index=0 + 全部动态输入完整维拼接。
+    // dims[]/n 由 argv[2] 指定文件读（逗号分隔）——档表就是构图期自算值）
+    uint32_t smid = 0;
+    if (aclmdlLoadFromFile(path, &smid) == ACL_SUCCESS) {
+        aclmdlDesc *sd = aclmdlCreateDesc();
+        aclmdlGetDesc(sd, smid);
+        size_t sg = 0;
+        aclmdlGetInputDynamicGearCount(sd, (size_t)-1, &sg);
+        printf("[probe] SetDims 试验载体: gears=%zu n_in=%zu\n", sg, aclmdlGetNumInputs(sd));
+        if (argc > 2) {
+            FILE *df = fopen(argv[2], "r");
+            if (df) {
+                int64_t vals[128];
+                size_t nv = 0;
+                while (nv < 128 && fscanf(df, "%lld,", &vals[nv]) == 1) nv++;
+                fclose(df);
+                // dataset 全输入 buffer（含 gear-info 尾输入）
+                size_t nin = aclmdlGetNumInputs(sd);
+                void **db = calloc(nin, sizeof(void *));
+                aclmdlDataset *ds = aclmdlCreateDataset();
+                for (size_t i = 0; i < nin; i++) {
+                    size_t sz = aclmdlGetInputSizeByIndex(sd, i);
+                    aclrtMalloc(&db[i], sz, ACL_MEM_MALLOC_HUGE_FIRST);
+                    aclmdlAddDatasetBuffer(ds, aclCreateDataBuffer(db[i], sz));
+                }
+                aclmdlIODims want;
+                memset(&want, 0, sizeof(want));
+                want.dimCount = nv;
+                for (size_t i = 0; i < nv; i++) want.dims[i] = (size_t)vals[i];
+                aclError rc = aclmdlSetInputDynamicDims(smid, ds, 0, &want);
+                printf("[probe] SetDims(%zu vals): rc=%d\n", nv, (int)rc);
+                for (size_t i = 0; i < nin; i++) {
+                    aclDestroyDataBuffer(aclmdlGetDatasetBuffer(ds, i));
+                    aclrtFree(db[i]);
+                }
+                aclmdlDestroyDataset(ds);
+            }
+        }
+        aclmdlDestroyDesc(sd);
+        aclmdlUnload(smid);
+    }
+
+    uint32_t mid1 = 0;
+    if (aclmdlLoadFromFile(path, &mid1) == ACL_SUCCESS) {
+        aclmdlDesc *d = aclmdlCreateDesc();
+        aclmdlGetDesc(d, mid1);
+        size_t g = 0;
+        aclError rc = aclmdlGetInputDynamicGearCount(d, (size_t)-1, &g);
+        printf("[probe] LoadFromFile: gears=%zu rc=%d n_in=%zu\n", g, (int)rc, aclmdlGetNumInputs(d));
+        if (g > 0 && g <= 128) {
+            aclmdlIODims gd[128];
+            aclError r2 = aclmdlGetInputDynamicDims(d, (size_t)-1, gd, g);
+            printf("[probe] DynamicDims(-1): rc=%d dimCount=%zu d0=%lld\n", (int)r2,
+                   r2 == 0 ? gd[0].dimCount : (size_t)0,
+                   r2 == 0 && gd[0].dimCount > 0 ? (long long)gd[0].dims[0] : -1LL);
+            // 逐输入 index 变体（-1 失败时的 fallback 取证）
+            if (r2 != 0) {
+                for (size_t idx = 0; idx < 4 && idx < aclmdlGetNumInputs(d); idx++) {
+                    aclmdlIODims gd2[128];
+                    aclError r3 = aclmdlGetInputDynamicDims(d, idx, gd2, g);
+                    printf("[probe] DynamicDims(idx=%zu): rc=%d dimCount=%zu\n", idx, (int)r3,
+                           r3 == 0 ? gd2[0].dimCount : (size_t)0);
+                }
+            }
+        }
+        aclmdlDestroyDesc(d);
+        aclmdlUnload(mid1);
+    } else {
+        printf("[probe] LoadFromFile FAIL\n");
+    }
+
+    FILE *f = fopen(path, "rb");
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    void *bytes = malloc(sz);
+    fread(bytes, 1, sz, f);
+    fclose(f);
+    uint32_t mid2 = 0;
+    if (aclmdlLoadFromMem(bytes, sz, &mid2) == ACL_SUCCESS) {
+        aclmdlDesc *d = aclmdlCreateDesc();
+        aclmdlGetDesc(d, mid2);
+        size_t g = 0;
+        aclError rc = aclmdlGetInputDynamicGearCount(d, (size_t)-1, &g);
+        printf("[probe] LoadFromMem:   gears=%zu rc=%d n_in=%zu\n", g, (int)rc, aclmdlGetNumInputs(d));
+        aclmdlDestroyDesc(d);
+        aclmdlUnload(mid2);
+    } else {
+        printf("[probe] LoadFromMem FAIL\n");
+    }
+    return 0;
+}
